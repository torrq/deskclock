# Deskclock Configuration File

# ---------------------------------------------------------
# STARTUP SETTINGS
# ---------------------------------------------------------

# START_SCREEN determines which view is shown when the clock boots up.
# Options: 
#   'animations' = Weather Animations
#   'camera'     = 5-Minute Traffic Camera Snapshot
#   'stream'     = Continuous Live YouTube Video Stream
START_SCREEN=animations

# ---------------------------------------------------------
# WEATHER & TIME SETTINGS
# ---------------------------------------------------------

# The URL to fetch weather data from (must return wttr.in j1 JSON format)
WEATHER_URL=http://wttr.in/Vancouver?format=j1

# The UTC offset for the bottom clock on the LED matrix (e.g. 8 for UTC+8, -8 for UTC-8)
BOTTOM_CLOCK_UTC_OFFSET=8

# ---------------------------------------------------------
# DISPLAY SETTINGS
# ---------------------------------------------------------

# Number of daisy-chained MAX7219 8-digit modules (default: 4)
MAX7219_DISPLAYS=4

# ---------------------------------------------------------
# CAMERA SETTINGS
# ---------------------------------------------------------

# How often to refresh the camera image in seconds (default 300 = 5 minutes)
CAMERA_REFRESH_INTERVAL=300

# The URL of the JPEG image or YouTube live-stream to display. 
# YouTube links (e.g. youtube.com/watch?v=...) will automatically be fetched using yt-dlp.
# All other links will be fetched directly as standard HTTP JPEGs.
CAMERA_URL=https://imgproxy.windy.com/_/full/plain/current/1575920021/original.jpg

# Frame rate for continuous YouTube Live Video mode (default: 10 FPS)
VIDEO_FPS=10

# The Gamma correction curve applied to the camera image to fix washed-out colors on the TFT screen.
# 1.0 = No correction (Linear). 2.2 = Standard sRGB correction (Recommended).
CAMERA_GAMMA=2.2

# How the image is scaled to fit the 160x128 screen.
# 'stretch' = Distorts the aspect ratio to force the image to fill the screen
# 'crop' = Maintains aspect ratio, zooming in to fill the screen and cropping edges (object-fit: cover)
CAMERA_SCALE_MODE=stretch

# Pre-processing crops: Number of pixels to slice off the original image BEFORE it gets scaled.
# Useful for removing timestamps, watermarks, or news tickers from the edges of public webcams.
CAMERA_CROP_TOP=0
CAMERA_CROP_BOTTOM=0
CAMERA_CROP_LEFT=0
CAMERA_CROP_RIGHT=0
